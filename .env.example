NODE_ENV=production
HOST=0.0.0.0
PORT=3100
TRUST_PROXY=false
PUBLIC_BASE_URL=https://crm.example.org

DASHBOARD_PASSWORD=
LOGIN_MAX_ATTEMPTS=3
SESSION_SECRET=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_POOL_SIZE=6

CORE_API_TOKEN=
MCP_API_TOKEN=
CONNECTOR_VAULT_KEY=
OAUTH_STATE_SECRET=

DATA_DIR=./runtime
UPLOAD_DIR=./runtime/uploads
HF_HOME=./runtime/huggingface
HTTP_TIMEOUT_MS=20000

# Local AI (CPU; skip optional CUDA downloads during installation)
ONNXRUNTIME_NODE_INSTALL_CUDA=skip
LOCAL_AI_ENABLED=true
LOCAL_AI_MODEL=onnx-community/Qwen2.5-0.5B-Instruct
LOCAL_AI_DTYPE=q4
# Maximum time for one local load + inference request (milliseconds).
LOCAL_AI_TIMEOUT_MS=180000
LOCAL_AI_MAX_NEW_TOKENS=320
LOCAL_AI_MAX_CONTEXT_CHARS=18000

# Optional external AI fallback
AI_BASE_URL=
AI_API_TOKEN=
AI_MODEL=

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://crm.example.org/oauth/google/callback
GOOGLE_SYNC_QUERY=newer_than:14d
GOOGLE_SYNC_MAX_RESULTS=50

# Hostinger Mail: IMAP receives, SMTP sends
HOSTINGER_MAIL_ENABLED=false
HOSTINGER_IMAP_HOST=imap.hostinger.com
HOSTINGER_IMAP_PORT=993
HOSTINGER_IMAP_SECURE=true
HOSTINGER_SMTP_HOST=smtp.hostinger.com
HOSTINGER_SMTP_PORT=465
HOSTINGER_SMTP_SECURE=true
HOSTINGER_MAIL_USER=
HOSTINGER_MAIL_PASSWORD=
HOSTINGER_MAIL_SYNC_DAYS=30

# Unofficial WhatsApp via Baileys
WHATSAPP_ENABLED=false
WHATSAPP_SESSION_DIR=./runtime/whatsapp-auth

SYNC_ENABLED=true
SYNC_INTERVAL_SECONDS=60
TASK_WORKER_ENABLED=true
TASK_WORKER_INTERVAL_SECONDS=15

MCP_ALLOW_WRITES=false
MCP_ALLOW_SENSITIVE_WRITES=false